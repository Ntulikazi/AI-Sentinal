# Set these values in the process environment before starting the API.
AI_SENTINEL_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://USER@localhost:5432/ai_sentinel
AI_SENTINEL_DATA_FILE=./data/ai_sentinel.json
AI_SENTINEL_LOG_LEVEL=INFO
AI_SENTINEL_DEV_IDENTITY_ENABLED=true
# Google OAuth web client ID. Use the same public client ID in Vite and Google Cloud.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Exact trusted frontend origins only. Production origins must use HTTPS.
AI_SENTINEL_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173
AI_SENTINEL_MAX_JOB_DURATION_SECONDS=1800
AI_SENTINEL_MAX_TOOL_CALLS=100
AI_SENTINEL_MAX_CONCURRENT_JOBS_PER_USER=2
AI_SENTINEL_MAX_REQUESTS_PER_MINUTE_PER_IP=120
# Optional per-policy overrides; when omitted, each policy uses the global limit above.
# AI_SENTINEL_MAX_ASSESSMENT_CREATIONS_PER_MINUTE_PER_IP=30
# AI_SENTINEL_MAX_SCAN_INITIATIONS_PER_MINUTE_PER_IP=30
# AI_SENTINEL_MAX_OTHER_WRITES_PER_MINUTE_PER_IP=120
AI_SENTINEL_MAX_AUTH_REQUESTS_PER_MINUTE_PER_IP=10
AI_SENTINEL_MAX_JOB_RETRIES=0
AI_SENTINEL_MAX_JOB_OUTPUT_BYTES=1000000
# Live evaluation is a local synthetic-only smoke test. Copy these values into
# the ignored project-root .env file and choose a current model ID from Inception.
# INCEPTION_API_KEY=
# INCEPTION_MODEL=
# AI_SENTINEL_INCEPTION_MAX_COMPLETION_TOKENS=256
# Required live-call token budget, shared by generated answers and DeepEval judging.
# AI_SENTINEL_MAX_LLM_TOKENS=8192
AI_SENTINEL_WORKER_POLL_INTERVAL_SECONDS=5
AI_SENTINEL_DAILY_ASSESSMENT_QUOTA=20
AI_SENTINEL_GITHUB_MCP_ENABLED=false
# When enabling repository scans, set AI_SENTINEL_GITHUB_MCP_IMAGE and the
# selected scanner image variables to official images pinned by SHA-256.
# Semgrep uses its bundled offline Python rules; unsupported languages are
# reported as NOT_TESTED rather than as a clean scan.
# AI_SENTINEL_SEMGREP_CONTAINER_IMAGE=semgrep/semgrep@sha256:<digest>
# AI_SENTINEL_GITLEAKS_CONTAINER_IMAGE=ghcr.io/gitleaks/gitleaks@sha256:<digest>
# For offline npm/Python dependency scans, also set the pinned OSV image and
# local database directory. The archives must be refreshed outside the scanner.
# AI_SENTINEL_OSV_SCANNER_CONTAINER_IMAGE=ghcr.io/google/osv-scanner@sha256:<digest>
# AI_SENTINEL_OSV_SCANNER_DATABASE_DIRECTORY=./data/osv-db
# AI_SENTINEL_OSV_SCANNER_DATABASE_MAX_AGE_DAYS=30
# Inject GITHUB_PERSONAL_ACCESS_TOKEN through the process environment or a
# secret manager; never commit the token or place it in Postman.
